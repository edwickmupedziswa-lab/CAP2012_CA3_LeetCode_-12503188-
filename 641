#include <vector>
using namespace std;

class MyCircularDeque {

private:

    vector<int> arr;
    int capacity;
    int front;
    int count;

public:

    MyCircularDeque(int k) {

        capacity = k;

        arr.resize(k);

        front = 0;

        count = 0;
    }


    bool insertFront(int value) {

        if (isFull()) {
            return false;
        }

        front = (front - 1 + capacity) % capacity;

        arr[front] = value;

        count++;

        return true;
    }

    bool insertLast(int value) {

        if (isFull()) {
            return false;
        }

        int rear = (front + count) % capacity;

        arr[rear] = value;

        count++;

        return true;
    }

    bool deleteFront() {

        if (isEmpty()) {
            return false;
        }

        front = (front + 1) % capacity;

        count--;

        return true;
    }

    bool deleteLast() {

        if (isEmpty()) {
            return false;
        }

        count--;

        return true;
    }

    int getFront() {

        if (isEmpty()) {
            return -1;
        }

        return arr[front];
    }

    int getRear() {

        if (isEmpty()) {
            return -1;
        }

        int rear = (front + count - 1) % capacity;

        return arr[rear];
    }

    bool isEmpty() {

        return count == 0;
    }

    bool isFull() {

        return count == capacity;
    }
};
